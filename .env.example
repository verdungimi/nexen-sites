# Environment variables of nexensites.hu. Set the real values in Vercel (Project > Settings > Environment Variables),
# never in the repository. For local development copy this file to .env.local.

# E-mail (Resend). EMAIL_FROM must be on a domain verified in Resend, otherwise confirmation e-mails
# to visitors are not delivered. Example: "Nexen Sites <hello@nexensites.hu>"
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_EMAIL=verdung.imi@gmail.com

# Supabase: where form submissions are saved (table: public.leads, see supabase/migrations).
# The service role key is a secret. It is used only in server-side API routes.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Measurement. Both load only after the visitor's consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Google review link for /velemeny, e.g. https://g.page/r/XXXX/review
NEXT_PUBLIC_GOOGLE_REVIEW_URL=

# Optional
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Legacy admin panel (app/(legacy))
NEXT_PUBLIC_CONVEX_URL=
